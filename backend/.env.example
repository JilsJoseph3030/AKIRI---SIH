# Copy to .env (server-side only — never EXPOSE these to clients)
# Twilio voice webhooks (required for /voice/*, else 503):
TWILIO_AUTH_TOKEN=
# Exact public URL Twilio calls, e.g. https://abc123.ngrok.io (signature depends on it):
VOICE_PUBLIC_BASE_URL=
# Salt for caller pseudonyms (voice:<hash12>):
VOICE_SALT=akiri-voice-change-me
# Web research (market refresh + vague-material lookup; snapshot/mock fallback without):
EXA_API_KEY=
# Call-agent LLM guidance (Muse Spark 1.3 contributor-free). Without it the
# keyword detectors carry every turn; provider errors are logged, never fatal:
OPENCODE_ZEN_API_KEY=
# Sarvam voice path (STT + translate + TTS). Without it, calls fall back
# to Twilio Gather speech + <Say>:
SARVAM_API_KEY=
# Optional overrides (defaults: saarika:v2.5, bulbul:v3, speaker anand):
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=anand
# Needed to download Twilio recordings for Sarvam STT:
TWILIO_ACCOUNT_SID=
