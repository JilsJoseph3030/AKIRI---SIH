# Copy to .env (Expo bakes EXPO_PUBLIC_* in at start time — restart after editing)
# API reachable from this machine:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# On a physical phone use the PC's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://10.112.211.101:8080
# Force live API even when unreachable (default true = demo fixtures):
EXPO_PUBLIC_API_MOCK=true
